--- a/etc/udhcpc.user.d/00-dhcp-update
+++ b/etc/udhcpc.user.d/00-dhcp-update
@@ -2,9 +2,11 @@
 dir=/tmp/ifstatus
 
 #Trigger ifstatus for PON WAN DHCP renew as netifd doesn't do it for PON WAN
-if [ "$1" == "renew" ]; then
-	if [[ "${INTERFACE}" == "wan" ]] && [[ "${interface}" == "pon*" ]]; then
-		logger -t udhcpc-user "PON ${interface} WAN renew, triggering wan_status update"
-		ifstatus ${INTERFACE} > ${dir}/${INTERFACE}_status
-	fi
+if [ "$1" = "renew" ] && [ "$INTERFACE" = "wan" ]; then
+	case "$interface" in
+		pon*)
+			logger -t udhcpc-user "PON ${interface} WAN renew, triggering wan_status update"
+			ifstatus "$INTERFACE" > "$dir/${INTERFACE}_status"
+			;;
+	esac
 fi
