-	for i in $router; do
+	local dhcp_routers="$router"
+	# RFC 3442: option 121 takes precedence over the Router option.
+	[ -n "$staticroutes" ] && dhcp_routers=
+	for i in $dhcp_routers; do
 		local gw_net
 		eval "$(ipcalc.sh "$i/$mask")";gw_net="$NETWORK"
 
